generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float?
  category    String   // e.g., Land, Commercial, Residential, Hospitality
  status      String   @default("AVAILABLE") // AVAILABLE, SOLD
  brochure    String?  // Optional URL to PDF brochure
  contactPhone String? // Optional contact phone number
  images      String   // Storing JSON string array of Cloudinary URLs
  leads       Lead[]
  units       PropertyUnit[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PropertyUnit {
  id          String   @id @default(cuid())
  title       String   // e.g. "Penthouse", "2BHK", "Community Living"
  description String?
  price       Float?
  size        String?  // e.g. "1200 sqft"
  images      String?  // Storing JSON string array of Cloudinary URLs
  status      String   @default("AVAILABLE")
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  message    String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
